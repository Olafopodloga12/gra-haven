[sub_resource type="Shader" id="Shader_3qqdm"]
code = "shader_type canvas_item;
uniform sampler2D tex: repeat_enable;
uniform float n_rows = 10;
uniform float y_offset = 0;

void fragment() {
	vec2 uv = UV;
	uv.y /= n_rows;
	uv.y += y_offset;
	COLOR.rgb *= texture(tex,uv).rgb;
}
"

